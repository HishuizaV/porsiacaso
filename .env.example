# Copia de referencia. NO guardes valores reales en el repositorio.
# En Windows PowerShell se definen así:  $env:SECRET_KEY = "..."

# OBLIGATORIA en producción: cadena larga y aleatoria. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 en el servidor público (activa cookies seguras, HSTS y exige SECRET_KEY)
PRODUCCION=0

# Dirección pública del sitio, sin barra final (canonicals, sitemap, Open Graph)
SITE_URL=http://127.0.0.1:5000

# Opcional. Por defecto: SQLite en porsiacaso.db. Ejemplo PostgreSQL:
# DATABASE_URL=postgresql://usuario:clave@servidor:5432/porsiacaso
DATABASE_URL=

# 1 solo si la app está detrás de un proxy (Nginx o el del proveedor)
CONFIAR_PROXY=0

# Opcional (compatibilidad): valor inicial de publicidad si aún no se configuró en el panel.
# off | maqueta | adsense   (lo recomendado es configurarlo en Panel > Configuración)
ANUNCIOS=off

# Solo en desarrollo local
FLASK_DEBUG=0
